# =============================================================================
# Exemplo de configuração do frontend. Copie para `.env.local` (desenvolvimento)
# ou configure no provedor de hospedagem (homologação/produção).
#
# ATENÇÃO: toda variável VITE_* é embutida no JavaScript enviado ao navegador,
# portanto é PÚBLICA. Nunca coloque aqui service_role, sb_secret_, senhas do
# banco ou tokens de acesso. O app recusa iniciar com chave privilegiada.
# =============================================================================

# Ambiente: development | staging | production
VITE_APP_ENV=development

# URL do projeto Supabase (homologação/produção exigem https://)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave publicável (anon / sb_publishable_...). Protegida pelas políticas RLS.
VITE_SUPABASE_ANON_KEY=COLE_AQUI_A_CHAVE_PUBLICAVEL
